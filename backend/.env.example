# Servidor
PORT=3000

# Banco de dados (SQLite local, arquivo criado automaticamente)
DATABASE_PATH=database.sqlite

JWT_SECRET=troque-este-valor-por-uma-string-secreta-e-aleatoria
JWT_EXPIRES_IN=7d

# Seed do primeiro admin (usado apenas por "npm run seed:admin")
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha
ADMIN_NAME=Administrador
